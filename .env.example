# DBSearch.AI data-plane config. Copy to .env and fill in after provisioning.
# .env is gitignored — NEVER commit real values.

# local (in-memory, default) | azure (real)
DBSEARCH_BACKEND=azure
DBSEARCH_TENANT_ID=acme              # OUR opaque tenant id (not a customer name)
DBSEARCH_EMBEDDING_DIM=1536          # must match the embedding model's dimensions

# --- Azure resources (from `az deployment group create` outputs) ---
AZURE_BLOB_ACCOUNT_URL=https://dbsacmestor.blob.core.windows.net
AZURE_BLOB_CONTAINER=dbsearch
AZURE_SERVICEBUS_NAMESPACE=dbsacme-sb.servicebus.windows.net
AZURE_SEARCH_ENDPOINT=https://dbsacme-search.search.windows.net
AZURE_SEARCH_INDEX=chunks
AZURE_SEARCH_ADMIN_KEY=              # Search service > Keys
AZURE_OPENAI_ENDPOINT=https://dbsacme-aoai.openai.azure.com/
AZURE_OPENAI_API_KEY=                # Azure OpenAI > Keys
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_DOCINTEL_ENDPOINT=https://dbsacme-docintel.cognitiveservices.azure.com/
AZURE_KEYVAULT_URL=https://dbsacme-kv.vault.azure.net/

# --- Entra app registration (Graph: identity + SharePoint) ---
AZURE_TENANT_ID=                     # your Entra (directory) tenant id
AZURE_CLIENT_ID=                     # app registration (client) id
AZURE_CLIENT_SECRET=                 # app registration client secret

# --- SharePoint source ---
SHAREPOINT_DRIVE_ID=                 # target document library drive id (see runbook)

# --- smoke test only ---
TEST_USER_OID=                       # an Entra user object id to run the query as
TEST_QUESTION=What proposals have we written for retail banks?

# ---------------------------------------------------------------------------------------
# Canvas connector credentials (#698). Every ${VAR} the canvas seeds into a node's config is
# a PROMISE that the deployment sets that variable - if nothing does, manifest substitution
# fails before the probe runs and the node can never connect, which looks like a broken
# product rather than missing config (#204).
#
# They are listed here, empty, for two reasons: this file is the one place a new user can
# discover what a connector needs, and it is the only source a test can check from the
# repository alone. Until now these lived exclusively in one developer's private .env, so
# selftest_canvas_fragility.py passed on that machine and failed for everyone else.
#
# Set only the groups you actually use; an unused group stays empty and its connector simply
# is not offered.
# ---------------------------------------------------------------------------------------

# Azure SQL Database
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=

# Azure Database for PostgreSQL
AZURE_PG_HOST=
AZURE_PG_DATABASE=
AZURE_PG_USER=
AZURE_PG_PASSWORD=

# Azure Database for MySQL
AZURE_MYSQL_HOST=
AZURE_MYSQL_DATABASE=
AZURE_MYSQL_USER=
AZURE_MYSQL_PASSWORD=

# Azure Synapse (dedicated SQL pool)
SYNAPSE_SERVER=
SYNAPSE_POOL=
SYNAPSE_USER=
SYNAPSE_PASSWORD=

# Azure Cosmos DB (NoSQL)
COSMOS_ENDPOINT=
COSMOS_DATABASE=
COSMOS_CONTAINER=
COSMOS_KEY=

# Google Drive (gdrive, #712) - a Drive-API-restricted API key, used ONLY to read PUBLIC
# folders ("Anyone with the link"). It is NOT an identity: it cannot read any private Drive.
# gdrive stores will fail to sync without it.
GOOGLE_API_KEY=
