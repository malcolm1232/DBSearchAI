# site/.env.example
# Server-side: URL of the FastAPI DEMO backend (must be a throwaway tenant booted
# with DBSEARCH_DEMO_SEED=1 — never a real customer tenant). Dev default: http://127.0.0.1:8090
# The demo backend MUST be booted with DBSEARCH_FORCE_EXTRACTIVE=1 so the default answer
# engine is the deterministic in-tenant Extractive model (no content egresses to an LLM),
# regardless of any ANTHROPIC_API_KEY/GROQ_API_KEY present in that backend's environment.
DBSEARCH_API_URL=http://127.0.0.1:8090

# Public: URL of the product app the "Open app" CTA links to. Dev default: http://127.0.0.1:8090
NEXT_PUBLIC_APP_URL=http://127.0.0.1:8090

# NEXT_PUBLIC_FORM_ENDPOINT is GONE (#962). The demo form posts to /demo-request on
# this same origin - the app that serves this site answers it. There is nothing to
# configure, which is the point: the old variable was unset on every build, so a
# placeholder URL shipped and every lead 404'd. Mail delivery is configured on the
# SERVER instead (DEMO_MAIL_API_KEY / DEMO_MAIL_FROM / DEMO_MAIL_TO), and an
# unconfigured mailer still stores the lead.
